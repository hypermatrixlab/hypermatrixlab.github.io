{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$roomId": {
        ".read": "$roomId.length >= 6 && $roomId.length <= 24",

        "meta": {
          ".write": "!data.exists() && newData.exists() && $roomId.length >= 6 && $roomId.length <= 24",
          ".validate": "newData.hasChildren(['title', 'dates', 'startMin', 'endMin', 'slotMin', 'createdAt'])",
          "title":     { ".validate": "newData.isString() && newData.val().length <= 120" },
          "tz":        { ".validate": "newData.isString() && newData.val().length <= 64" },
          "startMin":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
          "endMin":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
          "slotMin":   { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 240" },
          "duration":  { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 1440" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "dates": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isString() && newData.val().length <= 10" }
          },
          "$other": { ".validate": false }
        },

        "participants": {
          "$pid": {
            ".write": "$pid.length >= 6 && $pid.length <= 32 && newData.exists() && root.child('rooms').child($roomId).child('meta').exists()",
            ".validate": "newData.hasChildren(['name', 'color'])",
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "color":    { ".validate": "newData.isString() && newData.val().length <= 32" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "passwordHash": {
              ".validate": "newData.isString() && newData.val().length <= 128 && !data.exists()"
            },
            "slots": {
              "$slot": {
                ".validate": "newData.isString() && (newData.val() === 'yes' || newData.val() === 'maybe')"
              }
            },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
